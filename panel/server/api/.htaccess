# Alles unter /api/ landet in index.php, das die Adresse selbst auswertet.
# Läuft mod_rewrite nicht, trage in der App .../api/index.php als Adresse ein —
# dann funktioniert es über PATH_INFO genauso.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>
