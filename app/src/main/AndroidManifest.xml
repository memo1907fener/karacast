<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Only used when the owner switches auto-start on; the receiver checks first. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        The app is sideloaded, so it updates itself: it downloads the new file and
        hands it to Android's installer, which asks the viewer before anything is
        replaced. This permission only buys the right to ask.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Declares this as a TV app so it appears in the Google TV / Leanback launcher. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <!-- TV boxes have no touchscreen. Without this the app is filtered out on Play. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />

    <!--
        enableOnBackInvokedCallback="false": Ab Android 16 käme die Zurück-Taste
        sonst nicht mehr als Tastendruck an, sondern nur noch als Geste an die
        Navigation. Der Player braucht sie aber als Taste — sie schließt erst die
        Liste, das Menü, die Infoleiste und verlässt erst dann den Kanal.
    -->
    <application
        android:name=".IptvApp"
        android:allowBackup="true"
        android:banner="@drawable/app_banner"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafirIPTV"
        android:usesCleartextTraffic="true">

        <!--
            screenOrientation: nur quer, auch auf Handy und Tablet.

            Die Oberfläche ist für einen Fernseher gebaut — Kategorien links,
            Vorschau rechts, Kopfleiste oben. Hochkant passt davon nichts sinnvoll
            auf den Bildschirm. "sensorLandscape" hält die App im Querformat, lässt
            das Gerät aber um 180° drehen (Ladebuchse links oder rechts). Ein
            Fernseher ist ohnehin quer; für ihn ändert sich nichts.
        -->
        <activity
            android:name=".MainActivity"
            android:banner="@drawable/app_banner"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.SafirIPTV">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Google TV / Android TV home screen -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- Phones, tablets and TV boxes running a normal launcher -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Hands the downloaded update file to the system installer. Scoped to the
            cache folder the download lands in and nothing else — see file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            The television's launcher sends this once after installation, asking
            for the home-screen row. Answering it is all the receiver does.
        -->
        <receiver
            android:name=".HomeScreenReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.action.INITIALIZE_PROGRAMS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
