<?xml version="1.0" encoding="utf-8"?>
<!--
    IPTV providers very often serve playlists and streams over plain HTTP.
    Android 9+ blocks cleartext by default, so it is explicitly allowed here.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
