<?xml version="1.0" encoding="utf-8"?>
<!--
    Nur für die Play-Fassung: alles weg, was zum Selbst-Update gehört.

    Google erlaubt keiner Play-App, sich am Store vorbei selbst zu ersetzen, und
    REQUEST_INSTALL_PACKAGES allein reicht schon für eine Ablehnung. Updates
    kommen hier vom Play Store; der Code dafür ist abgeschaltet (BuildConfig.PLAY_STORE).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <!--
        Im Play Store nur für Fernseher und Tablets. Handys bekommen dort
        Karacast Mobil (eigene App, com.sternweb.karacast.mobile).

        Google Play blendet eine App für Bildschirme aus, die kleiner sind als der
        kleinste, den sie angibt: ohne „small“ und „normal“ fallen Handys heraus,
        Tablets („large“, „xlarge“) und Fernseher bleiben. Wer genauer schneiden
        will, kann einzelne Geräte zusätzlich im Gerätekatalog der Play Console
        ausschließen.
    -->
    <supports-screens
        android:smallScreens="false"
        android:normalScreens="false"
        android:largeScreens="true"
        android:xlargeScreens="true" />

    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            tools:node="remove" />
    </application>
</manifest>
